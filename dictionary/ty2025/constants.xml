    <Fact path="/isTaxYearLeapYear">
      <Name>Tax year is a leap year</Name>
      <Description>Whether the calendar tax year is a Gregorian leap year of 366 days: a year
        divisible by 4, except a year divisible by 100 that is not also divisible by 400. False for
        2025. Each divisibility test is written as RoundToInt(year / k) * k = year, which holds
        exactly when k divides the year.</Description>
      <Derived>
        <Any>
          <All>
            <Equal>
              <Left>
                <Multiply>
                  <RoundToInt>
                    <Divide>
                      <Dividend>
                        <Dependency path="/taxYear" />
                      </Dividend>
                      <Divisors>
                        <Dollar>4</Dollar>
                      </Divisors>
                    </Divide>
                  </RoundToInt>
                  <Int>4</Int>
                </Multiply>
              </Left>
              <Right>
                <Dependency path="/taxYear" />
              </Right>
            </Equal>
            <Not>
              <Equal>
                <Left>
                  <Multiply>
                    <RoundToInt>
                      <Divide>
                        <Dividend>
                          <Dependency path="/taxYear" />
                        </Dividend>
                        <Divisors>
                          <Dollar>100</Dollar>
                        </Divisors>
                      </Divide>
                    </RoundToInt>
                    <Int>100</Int>
                  </Multiply>
                </Left>
                <Right>
                  <Dependency path="/taxYear" />
                </Right>
              </Equal>
            </Not>
          </All>
          <Equal>
            <Left>
              <Multiply>
                <RoundToInt>
                  <Divide>
                    <Dividend>
                      <Dependency path="/taxYear" />
                    </Dividend>
                    <Divisors>
                      <Dollar>400</Dollar>
                    </Divisors>
                  </Divide>
                </RoundToInt>
                <Int>400</Int>
              </Multiply>
            </Left>
            <Right>
              <Dependency path="/taxYear" />
            </Right>
          </Equal>
        </Any>
      </Derived>
    </Fact>

