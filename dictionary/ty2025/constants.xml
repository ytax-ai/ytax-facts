    <Fact path="/majorityOfDaysInYear">
      <Name>Majority of days in year</Name>
      <Description>The smallest whole number of days that is more than one-half of the tax year: 183 in a 365-day year, 184 in a leap year (/isTaxYearLeapYear).</Description>
      
