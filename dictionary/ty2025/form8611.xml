    <Fact path="/form8611Buildings/*/basisAdditionYears/*/h">
      <Name>Line 2 Worksheet h</Name>
      <Description>Line 2 Worksheet h. See the cited form and instructions.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left>
                  <GreaterOf><Dependency path="../sourceLine16" /><Dollar>0</Dollar></GreaterOf>
                </Left>
                <Right>
                  <Dollar>0</Dollar>
                </Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Rational>0/1</Rational>
            </Then>
          </Case>
          <Case>
            <When>
              <GreaterThanOrEqual>
                <Left>
                  <GreaterOf><Dependency path="../sourceLine16" /><Dollar>0</Dollar></GreaterOf>
                </Left>
                <Right>
                  <GreaterOf><Dependency path="../sourceLine15" /><Dollar>0</Dollar></GreaterOf>
                </Right>
              </GreaterThanOrEqual>
            </When>
            <Then>
              <Rational>1/1</Rational>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Divide>
                <Dividend>
                  <RoundToInt>
                    <Divide>
                      <Dividend>
                        <Multiply>
                          <GreaterOf><Dependency path="../sourceLine16" /><Dollar>0</Dollar></GreaterOf>
                          <Int>1000000000</Int>
                        </Multiply>
                      </Dividend>
                      <Divisors>
                        <GreaterOf><Dependency path="../sourceLine15" /><Dollar>0</Dollar></GreaterOf>
                      </Divisors>
                    </Divide>
                  </RoundToInt>
                </Dividend>
                <Divisors>
                  <Int>1000000000</Int>
                </Divisors>
              </Divide>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>
