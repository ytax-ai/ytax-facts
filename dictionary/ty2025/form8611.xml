      <Description>/form8611Buildings/*/precedingYearQualifiedBasis floored at $0 when answered; otherwise the first-year qualified basis (floored at the $1 divisor guard), the value for a building with no decrease before this year.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <IsComplete>
                <Dependency path="../precedingYearQualifiedBasis" />
              </IsComplete>
            </When>
            <Then>
              <GreaterOf><Dependency path="../precedingYearQualifiedBasis" /><Dollar>0</Dollar> </GreaterOf>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <GreaterOf><Dependency path="../firstYearQualifiedBasis" /><Dollar>1</Dollar></GreaterOf> 
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>
