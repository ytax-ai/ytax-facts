<FactDictionaryModule>
  <Facts>
    <Fact path="/outFormRegularTaxBeforeCredits">
      <Name>Regular income tax plus Schedule 2 line 1z</Name>
      <Description>Regular income tax plus Schedule 2 line 1z. See the cited form and instructions.</Description>
      <Export downstreamFacts="true" />
      <Derived>
        <Add>
          <Dependency path="/tentativeTaxFromTaxableIncome" module="taxCalculations" />
          <Dependency path="/line1zOfSchedule2" module="schedule2" />
        </Add>
      </Derived>
    </Fact>
    <Fact path="/outFormCreditsBefore8834">
      <Name>Credits preceding the qualified electric vehicle credit</Name>
      <Description>Form 1040 line 19 and Schedule 3 lines 2-5b and 7, excluding 6a, 6b, this credit itself (6i), 6j and 6k. Sum the preceding credits explicitly to avoid circular dependencies through Schedule 3 line 7.</Description>
      <Export downstreamFacts="true" />
      <Derived>
        <Add>
          <Dependency path="/totalCtcAndOdc" module="ctcOdc" />
          <Dependency path="/cdccTotalCredit" module="cdcc" />
          <Dependency path="/sched3Line3" module="schedule3" />
          <Dependency path="/qualifiedSaverCreditAmount" module="saversCredits" />
          <Dependency path="/sched3Line5a" module="schedule3" />
          <Dependency path="/sched3Line5b" module="schedule3" />
          <Dependency path="/totalEdc" module="elderlyAndDisabled" />
          <Dependency path="/sched3Line6c" module="schedule3" />
          <Dependency path="/sched3Line6f" module="schedule3" />
          <Dependency path="/sched3Line6g" module="schedule3" />
          <Dependency path="/sched3Line6l" module="schedule3" />
          <Dependency path="/sched3Line6m" module="schedule3" />
          <Dependency path="/sched3Line6h" module="schedule3" />
          <Dependency path="/sched3Line6z" module="schedule3" />
        </Add>
      </Derived>
    </Fact>
    <Fact path="/outFormCreditsBefore8911">
      <Name>Credits preceding the personal refueling property credit</Name>
      <Description>Credits preceding the personal refueling property credit. See the cited form and instructions.</Description>
      <Export downstreamFacts="true" />
      <Derived>
        <Add>
          <Dependency path="/outFormCreditsBefore8834" />
          <Dependency path="/sched3Line6i" module="schedule3" />
        </Add>
      </Derived>
    </Fact>
    <Fact path="/outFormCreditsBefore8912">
      <Name>Credits preceding the bond holder credit</Name>
      <Description>Credits preceding the bond holder credit. See the cited form and instructions.</Description>
      <Export downstreamFacts="true" />
      <Derived>
        <Add>
          <Dependency path="/outFormCreditsBefore8911" />
          <Dependency path="/sched3Line6j" module="schedule3" />
        </Add>
      </Derived>
    </Fact>
  </Facts>
