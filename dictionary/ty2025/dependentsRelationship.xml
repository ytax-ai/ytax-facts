                  </Right>
                </Equal>
              </Any>
            </When>
            <Then>
              <String>PARENT</String>
            </Then>
          </Case>
          <Case>
            <When>
              <Any>
                <Equal>
                  <Left>
                    <Dependency path="../relationship" />
                  </Left>
                  <Right>
                    <Enum optionsPath="/relationshipOptions">sibling</Enum>
                  </Right>
                </Equal>
                <Equal>
