    <Fact path="/familyAndHousehold/*/isChildWithinMeaningOf152f1">
      <Name>Is a child within the meaning of IRC 152(f)(1)</Name>
      <Description>Whether this dependent is "a child of the taxpayer" as IRC 152(f)(1) defines
        that term: a son, daughter, stepson, stepdaughter, an eligible foster child, or a child
        treated the same because they were legally adopted or lawfully placed with the taxpayer
        for legal adoption. Narrower than ../relationshipCategoryIsChild, which is the wider IRC
        152(d)(2)(A) "child or a descendant of a child" category and so also passes a grandchild
        or other descendant of a child. Of the five childRelationship values, biologicalChild,
        adoptedChild, stepChild and fosterChild satisfy this definition; grandChildOrOtherDescendantOfChild
        does not. Read by the missing-children (kidnapped child) exception, whose own gate is
        exactly this term and not the wider category.</Description>
      <Export downstreamFacts="true" />
      <Derived>
        <Switch>
          <Case>
            <When>
              <Not>
                <Dependency path="../relationshipCategoryIsChild" />
              </Not>
            </When>
            <Then>
              <False />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Not>
                <Equal>
                  <Left>
                    <Dependency path="../childRelationship" />
                  </Left>
                  <Right>
                    <Enum optionsPath="/childRelationshipOptions">grandChildOrOtherDescendantOfChild</Enum>
                  </Right>
                </Equal>
              </Not>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>


