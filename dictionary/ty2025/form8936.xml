    <Fact path="/form8936UsedVehicleTaxLiabilityLimit">
      <Name>Form 8936 line 17 tax-liability limit for previously owned clean vehicles</Name>
      <Description>Form 8936 line 17 is Form 1040 line 18 minus the Form 8936 line-16 credits, floored at zero. The list is carried by the existing line-16 fact; this roll-up uses the same ordered credit limit for the multiple Schedule A line-17 amounts.</Description>
      <Export downstreamFacts="true" />
      
      <Derived><GreaterOf><Dollar>0</Dollar><Subtract><Minuend><Dependency module="taxCalculations" path="/totalTentativeTax" /></Minuend><Subtrahends><Dependency module="cleanVehicleCreditRepayment" path="/form8936CreditsOrderedBeforeUsedCredit" /></Subtrahends></Subtract></GreaterOf></Derived>
    </Fact>
    <Fact path="/form8936Schedule3Line6mUsedCleanVehicleCredit">
      <Name>Form 8936 line 18 export: previously owned clean vehicle credit to Schedule 3 line 6m</Name>
      <Description>When per-vehicle Schedule A items are present, this is the smaller of the sum of their line-17 amounts and the return-level tax capacity at Form 8936 line 17. Otherwise it preserves the existing scalar computation. Schedule 3 must read this export only after IsComplete is true.</Description>
      <Export downstreamFacts="true" />
      
      <Derived><Switch><Case><When><All><IsComplete><Dependency module="form8936sa" path="/form8936Vehicles" /></IsComplete><GreaterThan><Left><CollectionSize><Dependency module="form8936sa" path="/form8936VehiclesToPrint" /></CollectionSize></Left><Right><Int>0</Int></Right></GreaterThan><Dependency module="form8936sa" path="/form8936VehicleSchedulesComplete" /></All></When><Then><LesserOf><Dependency path="/form8936PartIVCreditFromScheduleA" /><Dependency path="/form8936UsedVehicleTaxLiabilityLimit" /></LesserOf></Then></Case><Case><When><All><IsComplete><Dependency module="form8936sa" path="/form8936Vehicles" /></IsComplete><Equal><Left><CollectionSize><Dependency module="form8936sa" path="/form8936VehiclesToPrint" /></CollectionSize></Left><Right><Int>0</Int></Right></Equal></All></When><Then><Dependency module="cleanVehicleCreditRepayment" path="/usedCleanVehicleCredit" /></Then></Case></Switch></Derived>
    </Fact>
    <Fact path="/form8936CreditsOrderedBeforeNewVehicleCredit">
      <Name>Credits ordered before the new clean vehicle credit (Form 8936 line 11)</Name>
      <Description>Form 8936 line 11 is the prior-credit list on Form 8936 line 16 plus the Form 8936 line 18 previously owned vehicle credit, which is used before the new clean vehicle credit.</Description>
      <Export downstreamFacts="true" />
      
      <Derived><Add><Dependency module="cleanVehicleCreditRepayment" path="/form8936CreditsOrderedBeforeUsedCredit" /><Dependency module="form8936" path="/form8936Schedule3Line6mUsedCleanVehicleCredit" /></Add></Derived>
    </Fact>
    <Fact path="/form8936NewVehicleTaxLiabilityLimit">
      <Name>Form 8936 line 12 tax-liability limit for the personal-use new clean vehicle credit</Name>
      <Description>Form 8936 line 12 is Form 1040 line 18 minus the line-11 credits, floored at zero.</Description>
      <Export downstreamFacts="true" />
      
      <Derived><GreaterOf><Dollar>0</Dollar><Subtract><Minuend><Dependency module="taxCalculations" path="/totalTentativeTax" /></Minuend><Subtrahends><Dependency module="form8936" path="/form8936CreditsOrderedBeforeNewVehicleCredit" /></Subtrahends></Subtract></GreaterOf></Derived>
    </Fact>
    <Fact path="/form8936Schedule3Line6fNewCleanVehicleCredit">
      <Name>Form 8936 line 13 export: new clean vehicle credit to Schedule 3 line 6f</Name>
      <Description>When per-vehicle Schedule A items are present, this is the smaller of line 9 (their line-12 amounts) and the return-level tax capacity at Form 8936 line 12; where line 9 refuses because additional new vehicles carrying a credit sit beside the copies, this line is Incomplete too. Otherwise it preserves the existing scalar computation, which limits the same all-vehicle aggregate line 9 prints. Schedule 3 must read this export only after IsComplete is true.</Description>
      <Export downstreamFacts="true" />
      
      <Derived><Switch><Case><When><All><IsComplete><Dependency module="form8936sa" path="/form8936Vehicles" /></IsComplete><GreaterThan><Left><CollectionSize><Dependency module="form8936sa" path="/form8936VehiclesToPrint" /></CollectionSize></Left><Right><Int>0</Int></Right></GreaterThan><Dependency module="form8936sa" path="/form8936VehicleSchedulesComplete" /></All></When><Then><LesserOf><Dependency path="/form8936PartIIIPersonalUseCreditFromScheduleA" /><Dependency path="/form8936NewVehicleTaxLiabilityLimit" /></LesserOf></Then></Case><Case><When><All><IsComplete><Dependency module="form8936sa" path="/form8936Vehicles" /></IsComplete><Equal><Left><CollectionSize><Dependency module="form8936sa" path="/form8936VehiclesToPrint" /></CollectionSize></Left><Right><Int>0</Int></Right></Equal></All></When><Then><Dependency module="cleanVehicleCreditRepayment" path="/newCleanVehicleCredit" /></Then></Case></Switch></Derived>
    </Fact>
