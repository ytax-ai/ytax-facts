itFromPassThroughEntities" /></Left><Right><Dollar>0</Dollar></Right></GreaterThan></All><All><IsComplete><Dependency module="cleanVehicleCreditRepayment" path="/newCleanVehicleCredit" /></IsComplete><GreaterThan><Left><Dependency module="cleanVehicleCreditRepayment" path="/newCleanVehicleCredit" /></Left><Right><Dollar>0</Dollar></Right></GreaterThan></All><All><IsComplete><Dependency module="cleanVehicleCreditRepayment" path="/usedCleanVehicleCredit" /></IsComplete><GreaterThan><Left><Dependency module="cleanVehicleCreditRepayment" path="/usedCleanVehicleCredit" /></Left><Right><Dollar>0</Dollar></Right></GreaterThan></All></Any></Then>
